{
  "mode": "local_rehearsal",
  "storage": "sqlite_local",
  "database_path": "C:/local-rehearsal/platform/platform.sqlite",
  "contract_directory": "C:/YOKI/Codex/tianshu-peiban-bot/contracts/text-dialogue/v1",
  "principals": {
    "admin": {
      "kind": "operator",
      "service": "platform",
      "token_env": "WEB_ADMIN_INTERNAL_TOKEN",
      "account": {
        "namespace": "web",
        "immutable_account_id": "household-admin"
      },
      "actions": [
        "origin.issue",
        "source.register",
        "source.dispatch",
        "mapping.prepare",
        "origin.revoke",
        "entry.revoke",
        "principal.revoke",
        "config.publish",
        "config.view",
        "config.revoke",
        "device.control"
      ]
    },
    "core-reader": {
      "kind": "service",
      "service": "companion",
      "token_env": "CORE_PLATFORM_READER_TOKEN",
      "actions": ["source.input", "mapping.confirm", "origin.resolve"],
      "resolver": {
        "caller": "platform",
        "purpose": "dialogue"
      }
    },
    "core-sender": {
      "kind": "service",
      "service": "companion",
      "token_env": "CORE_PLATFORM_WEB_SENDER_TOKEN",
      "actions": ["dialogue.send"]
    },
    "memory-reader": {
      "kind": "service",
      "service": "memory",
      "token_env": "MEMORY_PLATFORM_READER_TOKEN",
      "actions": ["source.current", "origin.resolve"],
      "resolver": {
        "caller": "companion",
        "purpose": "dialogue"
      }
    }
  },
  "entries": {
    "web-actor": {
      "owner": "admin",
      "kind": "local_operator",
      "account": {
        "namespace": "web",
        "immutable_account_id": "household-admin"
      },
      "channel": {
        "namespace": "web",
        "binding_id": "web-household",
        "channel_conversation_id": "private-chat",
        "thread_id": null
      },
      "actor_id": "actor:household",
      "audience": "self_private",
      "ttl_seconds": 300,
      "routes": [
        {
          "caller": "platform",
          "receiver": "companion",
          "purpose": "dialogue"
        },
        {
          "caller": "companion",
          "receiver": "memory",
          "purpose": "dialogue"
        },
        {
          "caller": "companion",
          "receiver": "platform",
          "purpose": "dialogue"
        }
      ]
    }
  },
  "input_entries": {
    "web-input": {
      "owner": "admin",
      "account": {
        "namespace": "web",
        "immutable_account_id": "household-admin"
      },
      "channel": {
        "namespace": "web",
        "binding_id": "web-household",
        "channel_conversation_id": "private-chat",
        "thread_id": null
      },
      "audience": "self_private",
      "ttl_seconds": 300,
      "actor_entries": ["web-actor"],
      "default_actor_ids": ["actor:household"],
      "routing_version": 1
    }
  },
  "providers": {},
  "web": {
    "origin": "http://127.0.0.1:4814",
    "username": "replace-with-local-admin-name",
    "password_hash": "REPLACE_WITH_INTERACTIVE_SCRYPT_HASH",
    "principal": "admin",
    "input_entries": ["web-input"],
    "static_directory": "C:/tianshu-platform/apps/web/dist",
    "dialogue_enabled": false
  },
  "web_models": {
    "enabled": false,
    "unlock_ttl_seconds": 900,
    "templates": [
      {
        "template_id": "chat-local-text",
        "label": "本地演练 · Chat 文本",
        "target": "chat",
        "provider_id": "replace-with-reviewed-chat-provider",
        "verified_capabilities": ["text"],
        "lifetime_seconds": 300,
        "timeout_ms": 30000
      },
      {
        "template_id": "native-local-text",
        "label": "本地演练 · 原生 Responses",
        "target": "native",
        "provider_id": "replace-with-reviewed-native-provider",
        "verified_capabilities": ["text", "stream"],
        "lifetime_seconds": 300
      }
    ]
  },
  "home": {
    "enabled": false,
    "base_url": "http://127.0.0.1:8123",
    "reviewed_addresses": ["127.0.0.1"],
    "allow_private_http": true,
    "token_env": "TS017_HA_TOKEN",
    "unlock_ttl_seconds": 900,
    "timeout_seconds": 4,
    "status_max_age_seconds": 120,
    "entities": [
      { "entity_id": "light.study", "label": "书房灯", "kind": "light" },
      { "entity_id": "switch.kettle", "label": "热水壶", "kind": "switch" },
      {
        "entity_id": "sensor.living_temperature",
        "label": "客厅温度",
        "kind": "sensor",
        "unit": "°C"
      }
    ],
    "templates": [
      {
        "template_id": "study-light-on",
        "label": "打开书房灯",
        "entity_id": "light.study",
        "service": "turn_on"
      },
      {
        "template_id": "study-light-off",
        "label": "关闭书房灯",
        "entity_id": "light.study",
        "service": "turn_off"
      },
      {
        "template_id": "kettle-on",
        "label": "打开热水壶",
        "entity_id": "switch.kettle",
        "service": "turn_on"
      }
    ]
  }
}
