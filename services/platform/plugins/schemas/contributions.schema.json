{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianshu.invalid/contracts/plugin-runtime/candidate-v1/schemas/contributions.schema.json",
  "title": "Exported plugin contributions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "handler",
          "input_schema",
          "output_schema",
          "effect",
          "timeout_seconds",
          "idempotency",
          "resumable",
          "required_capabilities"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "handler": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "input_schema": {
            "$ref": "common.schema.json#/$defs/schema"
          },
          "output_schema": {
            "$ref": "common.schema.json#/$defs/schema"
          },
          "effect": {
            "enum": [
              "read",
              "write"
            ]
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "idempotency": {
            "enum": [
              "none",
              "provider",
              "reconcile"
            ]
          },
          "reconcile_handler": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "resume_handler": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "resumable": {
            "type": "boolean"
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/capability"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "idempotency": {
                  "const": "reconcile"
                }
              }
            },
            "then": {
              "required": [
                "reconcile_handler"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "resumable": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "resume_handler"
              ]
            }
          }
        ]
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "names",
          "action",
          "arguments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "names": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "property",
                "position",
                "rest"
              ],
              "properties": {
                "property": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
                },
                "position": {
                  "type": "integer",
                  "minimum": 0
                },
                "rest": {
                  "type": "boolean"
                }
              }
            }
          },
          "reply_pointer": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "action",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event_type",
          "event_version",
          "handler",
          "required_capabilities"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "event_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "event_version": {
            "type": "integer",
            "minimum": 1
          },
          "handler": {
            "type": "string",
            "minLength": 1
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/capability"
            }
          }
        }
      }
    },
    "bridges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "handler",
          "proactive",
          "required_capabilities",
          "timeout_seconds",
          "idempotency",
          "resumable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "handler": {
            "type": "string",
            "minLength": 1
          },
          "prefixes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proactive": {
            "type": "boolean"
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/capability"
            }
          },
          "prefixes_config_key": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "match_handler": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "idempotency": {
            "enum": [
              "none",
              "provider",
              "reconcile"
            ]
          },
          "resumable": {
            "type": "boolean"
          },
          "reconcile_handler": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "resume_handler": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "oneOf": [
          {
            "required": [
              "prefixes"
            ],
            "not": {
              "required": [
                "prefixes_config_key"
              ]
            }
          },
          {
            "required": [
              "prefixes_config_key"
            ],
            "not": {
              "required": [
                "prefixes"
              ]
            }
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "idempotency": {
                  "const": "reconcile"
                }
              }
            },
            "then": {
              "required": [
                "reconcile_handler"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "resumable": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "resume_handler"
              ]
            }
          }
        ]
      }
    },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "input",
          "default"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "input": {
            "type": "object"
          },
          "default": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "timezone",
              "misfire",
              "overlap"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "interval",
                  "cron"
                ]
              },
              "seconds": {
                "type": "integer",
                "minimum": 1
              },
              "cron": {
                "type": "string",
                "pattern": "^\\S+(?:\\s+\\S+){4}$"
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              },
              "misfire": {
                "enum": [
                  "skip",
                  "coalesce"
                ]
              },
              "overlap": {
                "enum": [
                  "skip",
                  "queue_one"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "interval"
                    }
                  }
                },
                "then": {
                  "required": [
                    "seconds"
                  ],
                  "not": {
                    "required": [
                      "cron"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "cron"
                    }
                  }
                },
                "then": {
                  "required": [
                    "cron"
                  ],
                  "not": {
                    "required": [
                      "seconds"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "entry",
          "actions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "$ref": "common.schema.json#/$defs/path"
          },
          "actions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
            }
          },
          "icon": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
