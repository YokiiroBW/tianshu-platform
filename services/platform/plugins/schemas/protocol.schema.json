{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianshu.invalid/contracts/plugin-runtime/candidate-v1/schemas/protocol.schema.json",
  "title": "Plugin invocation, receipt, event and message envelopes",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocol_version",
        "invocation_id",
        "intent_key",
        "context_ref",
        "instance_id",
        "package_version",
        "config_revision",
        "binding_id",
        "binding_revision",
        "deadline",
        "input",
        "entry"
      ],
      "properties": {
        "kind": {
          "const": "invocation"
        },
        "protocol_version": {
          "const": 1
        },
        "invocation_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "intent_key": {
          "type": "string",
          "minLength": 1
        },
        "context_ref": {
          "type": "string",
          "minLength": 1
        },
        "instance_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "package_version": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "config_revision": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "binding_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding_revision": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "input": {
          "type": "object"
        },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "action",
                "event",
                "bridge"
              ]
            },
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "binding_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "binding_revision": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "binding_revision": {
                "$ref": "common.schema.json#/$defs/revision"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocol_version",
        "invocation_id",
        "execution",
        "effect",
        "delivery",
        "updated_at",
        "revision"
      ],
      "properties": {
        "kind": {
          "const": "receipt"
        },
        "protocol_version": {
          "const": 1
        },
        "invocation_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "execution": {
          "enum": [
            "accepted",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "effect": {
          "enum": [
            "none",
            "not_applied",
            "applied",
            "unknown"
          ]
        },
        "delivery": {
          "enum": [
            "not_requested",
            "pending",
            "delivered",
            "failed",
            "unknown"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "result": {},
        "error": {
          "$ref": "common.schema.json#/$defs/error"
        },
        "checkpoint_ref": {
          "type": "string",
          "minLength": 1
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "resource_type",
            "id",
            "status",
            "observed_at"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
            },
            "resource_type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "presentation": {
          "type": "array",
          "items": {
            "$ref": "#/oneOf/3/properties/segments/items"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "properties": {
                  "retriable": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution": {
                "enum": [
                  "failed",
                  "interrupted"
                ]
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocol_version",
        "event_id",
        "type",
        "version",
        "occurred_at",
        "source",
        "context_ref",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "event"
        },
        "protocol_version": {
          "const": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "context_ref": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocol_version",
        "message_id",
        "target_ref",
        "segments",
        "origin_chain",
        "direction"
      ],
      "properties": {
        "kind": {
          "const": "message"
        },
        "protocol_version": {
          "const": 1
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "reply_to": {
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "text"
                ],
                "properties": {
                  "type": {
                    "const": "text"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "file_ref"
                ],
                "properties": {
                  "type": {
                    "const": "image"
                  },
                  "file_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "alt": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "actor_ref"
                ],
                "properties": {
                  "type": {
                    "const": "mention"
                  },
                  "actor_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "message_ref"
                ],
                "properties": {
                  "type": {
                    "const": "reply"
                  },
                  "message_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "file_ref",
                  "name"
                ],
                "properties": {
                  "type": {
                    "const": "file"
                  },
                  "file_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "origin_chain": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "direction": {
          "enum": [
            "inbound",
            "outbound"
          ]
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "context_ref": {
          "type": "string",
          "minLength": 1
        },
        "sender_ref": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "conversation": {
          "$ref": "common.schema.json#/$defs/conversation"
        },
        "sender": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform_user_id"
          ],
          "properties": {
            "platform_user_id": {
              "type": "string",
              "minLength": 1
            },
            "display_name": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "direction": {
                "const": "inbound"
              }
            }
          },
          "then": {
            "required": [
              "event_id",
              "context_ref",
              "sender_ref",
              "occurred_at",
              "conversation",
              "sender"
            ]
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocol_version",
        "invocation_id",
        "input",
        "checkpoint",
        "previous_receipt",
        "dispatch"
      ],
      "properties": {
        "kind": {
          "const": "recovery"
        },
        "protocol_version": {
          "const": 1
        },
        "invocation_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "input": {
          "type": "object"
        },
        "checkpoint": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "revision"
              ],
              "properties": {
                "value": {
                  "type": "object"
                },
                "revision": {
                  "$ref": "common.schema.json#/$defs/revision"
                }
              }
            }
          ]
        },
        "previous_receipt": {
          "$ref": "#/oneOf/1"
        },
        "dispatch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "not_sent",
                "sent",
                "unknown"
              ]
            },
            "provider_key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
